[Unit]
Description=Nextcloud Restic backup to MinIO S3
Requires=docker.service mnt-ncdata.mount
After=docker.service mnt-ncdata.mount

[Service]
Type=oneshot
ExecStart=/opt/bin/backup-nextcloud.sh
Environment=HOME=/home/core
# restic lives in /opt/bin (placed 2026-03-07); systemd default PATH misses it
Environment=PATH=/opt/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
TimeoutStartSec=6h
