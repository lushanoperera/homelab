# Nextcloud Docker Stack Environment
# Copy to .env and fill in values before deploying

# Postgres (superuser — AIO DB dump uses role oc_nextcloud internally)
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nextcloud_database

# Nextcloud
NEXTCLOUD_VERSION=32
NEXTCLOUD_TRUSTED_DOMAINS=localhost nextcloud.home.disconnesso.com nextcloud.lushanoperera.com nextcloud.giulyart.it 192.168.100.101
NEXTCLOUD_URL=https://nextcloud.home.disconnesso.com
TZ=Europe/Rome
