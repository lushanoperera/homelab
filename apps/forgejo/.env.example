# Forgejo environment variables
# Copy to .env and fill in values before deploying
#
# No secrets required for basic SQLite setup.
# Add overrides here if needed (e.g., SMTP for notifications):
# FORGEJO__mailer__ENABLED=true
# FORGEJO__mailer__SMTP_ADDR=smtp.example.com
# FORGEJO__mailer__SMTP_PORT=587
# FORGEJO__mailer__FROM=forgejo@example.com
# FORGEJO__mailer__USER=apikey
# FORGEJO__mailer__PASSWD=your-smtp-password
