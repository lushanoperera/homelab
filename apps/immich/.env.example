# Immich Docker Stack Environment
# Copy to .env and fill in values before deploying

# Postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

# Immich
# Pin an exact tag (vX.Y.Z), never a floating one — the ML service in LXC 107 must
# carry the SAME value in apps/immich-ml/.env. Immich is excluded from Watchtower.
IMMICH_VERSION=v3.2.0
# ML service lives in LXC 107 (apps/immich-ml/); override only if it moves
# IMMICH_MACHINE_LEARNING_URL=http://192.168.100.107:3003
TZ=Europe/Rome

# Cloudflare Access (for public endpoint protection)
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
