# Infrastructure services (Proxmox hosts, NAS, DNS — all HTTPS backends)

@winston host winston.home.disconnesso.com
handle @winston {
	reverse_proxy https://192.168.100.38:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

@reginald host reginald.home.disconnesso.com
handle @reginald {
	reverse_proxy https://192.168.100.4:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

@pbs host pbs.home.disconnesso.com
handle @pbs {
	reverse_proxy https://192.168.100.187:8007 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

@qnap host qnap.home.disconnesso.com
handle @qnap {
	reverse_proxy 192.168.100.254:8080
}

@technitium host technitium.home.disconnesso.com
handle @technitium {
	reverse_proxy 192.168.100.120:5380
}

@pdm host pdm.home.disconnesso.com
handle @pdm {
	reverse_proxy https://192.168.100.106:8443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# DoH endpoint — Technitium primary at 192.168.100.120:443/dns-query
# (reginald LXC 120, elevated to cluster primary 2026-07-11; DoH optional
# protocol enabled with self-signed cert /etc/dns/doh.pfx — the web console
# port 53443 no longer serves /dns-query on Technitium 15.x).
# LAN-only: not exposed via Cloudflare Tunnel. Caddy → Technitium hop stays
# on Storage/Infra LAN; tls_insecure_skip_verify needed because Technitium
# serves a self-signed cert on 443.
@dns host dns.home.disconnesso.com
handle @dns {
	reverse_proxy https://192.168.100.120:443 {
		transport http {
			tls
			tls_insecure_skip_verify
		}
	}
}
