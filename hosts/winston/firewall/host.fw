# Winston host firewall — Primary Proxmox host (192.168.100.38 / 192.168.200.38).
#
# Authoritative path: /etc/pve/nodes/winston/host.fw
# Repo copy: version control + DR restore. pmxcfs is NOT preserved across
# bare-metal reinstall (same gap that lost vzdump jobs in 2025-10).
#
# Relies on cluster.fw for: admin_sources, storage_lan, pbs_host, pdm_host,
# and the admin_access security group.
#
# Staged as enable: 0 and policy_in: ACCEPT. The rollout runbook flips to
# enable: 1 + policy_in: ACCEPT first (Phase A, log dwell), then policy_in:
# DROP (Phase B) after a 30-minute observation window on pve-firewall.log.

[OPTIONS]
enable: 0
policy_in: ACCEPT
policy_out: ACCEPT
log_level_in: info
log_level_out: nolog
ndp: 0
nf_conntrack_max: 262144

[RULES]

# Admin management plane: SSH, webui, SPICE, noVNC/VNC from admin_sources.
GROUP admin_access

# Diagnostics. Source-restricted icmp kept loose — marginal info leak is
# worth less than easy ping debugging from any VLAN.
IN ACCEPT -p icmp -log nolog

# No explicit catch-all drop. `policy_in` + `log_level_in: info` handles
# it at the policy layer. An explicit `IN DROP` here would fire BEFORE
# `policy_in` evaluates, silently defeating the Phase A ACCEPT dwell.
