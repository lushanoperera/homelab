# Homepage Dashboard - Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# General
PUID=1000
PGID=1000
TZ=Europe/Rome

# Media Stack - *arr API keys
# Found in: each app → Settings → General → API Key
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
BAZARR_API_KEY=
PROWLARR_API_KEY=
TAUTULLI_API_KEY=
SEERR_API_KEY=
SABNZBD_API_KEY=

# qBittorrent
# Default admin password (check Settings → Web UI)
QBITTORRENT_PASSWORD=

# Nextcloud
# Requires admin user with "Server Info" app enabled
# Settings → Overview shows serverinfo data
NEXTCLOUD_USER=admin
NEXTCLOUD_PASSWORD=

# Immich
# Admin → API Keys → Create new key
IMMICH_API_KEY=

# Home Assistant
# Profile → Long-Lived Access Tokens → Create Token
HOMEASSISTANT_API_KEY=

# Portainer
# Settings → API Key → Add access token
PORTAINER_API_KEY=

# Plex
# https://www.plex.tv/claim/ or Settings → General → X-Plex-Token
PLEX_API_KEY=

# Proxmox VE API Token
# Create on both Winston and Reginald:
#   pveum user token add root@pam homepage --privsep=1
#   pveum acl modify / --tokens root@pam!homepage --roles PVEAuditor
# Format: root@pam!homepage
PROXMOX_TOKEN_ID=
# Each host has its own token secret (created independently)
PROXMOX_WINSTON_SECRET=
PROXMOX_REGINALD_SECRET=
