[Unit]
Description=Load patched i915 and setup GPU
After=systemd-sysext.service i915-sriov-rebuild.service
Wants=systemd-sysext.service
ConditionPathExists=/etc/extensions/i915-sriov.raw

[Service]
Type=oneshot
# Load i915 dependencies (depmod can't update indexes on read-only /lib/modules)
ExecStartPre=/usr/sbin/modprobe drm
ExecStartPre=/usr/sbin/modprobe drm_kms_helper
ExecStartPre=/usr/sbin/modprobe drm_display_helper
ExecStartPre=/usr/sbin/modprobe drm_buddy
ExecStartPre=/usr/sbin/modprobe ttm
ExecStartPre=/usr/sbin/modprobe drm_ttm_helper
ExecStartPre=/usr/sbin/modprobe video
ExecStartPre=/usr/sbin/modprobe intel-gtt
ExecStartPre=/usr/sbin/modprobe i2c-algo-bit
ExecStartPre=/usr/sbin/modprobe hwmon
# DKMS 2025.10.10+ ships intel_sriov_compat.ko (backport_* symbols) — must load before i915.
# Guarded: skip if already loaded or if this sysext build predates the compat module.
ExecStartPre=/bin/sh -c 'test -d /sys/module/intel_sriov_compat || ! test -f /usr/lib/modules/$(uname -r)/updates/i915-sriov-compat/intel_sriov_compat.ko || /usr/sbin/insmod /usr/lib/modules/$(uname -r)/updates/i915-sriov-compat/intel_sriov_compat.ko'
# Load sysext i915 via insmod (modprobe would load stock module from stale index).
# Skip if already loaded (e.g., manual restart).
ExecStartPre=/bin/sh -c 'test -d /sys/module/i915 || /usr/sbin/insmod /usr/lib/modules/$(uname -r)/updates/i915/i915.ko enable_guc=3'
ExecStartPre=/usr/bin/udevadm control --reload-rules
ExecStartPre=/usr/bin/udevadm trigger --subsystem-match=drm
ExecStart=/opt/bin/verify-gpu.sh
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
