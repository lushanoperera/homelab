[Unit]
Description=Rebuild i915-sriov sysext if kernel changed
After=docker.service systemd-sysext.service
Before=gpu-setup.service
ConditionPathExists=/etc/extensions/i915-sriov.raw

[Service]
Type=oneshot
ExecStart=/opt/bin/i915-sriov-rebuild.sh
RemainAfterExit=true
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
