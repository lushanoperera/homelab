{"ignition":{"version":"3.4.0"},"passwd":{"users":[{"name":"core","sshAuthorizedKeys":["ssh-rsa  lushano@MacBook-Pro-di-Lushano.local"]}]},"storage":{"files":[{"path":"/etc/systemd/network/10-static.network","contents":{"compression":"gzip","source":"data:;base64,H4sIAAAAAAAC/3TJsQrCMBCA4f0epl5iLTpkKAoiYhEdS4cjPW0Qk5KcFt9eOpbS4V/+r76Q2K6Bit5sWDoEqCuWIcRXA2XbRk7JqJ3OVLHNFOLYSucLpJZpPdKRhAf6TQkO1X1y9CafPYU4fxrhdP0WpbXcy600PsCZud8H/3DPTyRxwZskJM7CPwAA//80Hj8o6QAAAA=="},"mode":420},{"path":"/etc/systemd/network/20-eth1-dmz.network","contents":{"compression":"","source":"data:,%5BMatch%5D%0AName%3Deth1%0A%0A%5BNetwork%5D%0AAddress%3D192.168.7.119%2F24%0A"},"mode":420},{"path":"/etc/systemd/network/30-eth2-storage.network","contents":{"compression":"","source":"data:,%5BMatch%5D%0AName%3Deth2%0A%0A%5BNetwork%5D%0AAddress%3D192.168.200.100%2F24%0A"},"mode":420},{"path":"/etc/modules-load.d/nfs.conf","contents":{"compression":"","source":"data:,nfs%0Anfsd%0Arpcsec_gss_krb5%0A"},"mode":420},{"path":"/opt/portainer/docker-compose.yml","contents":{"compression":"gzip","source":"data:;base64,"},"mode":420},{"path":"/usr/lib/docker/cli-plugins/docker-compose","contents":{"source":"https://github.com/docker/compose/releases/download/v2.40.3/docker-compose-linux-x86_64"},"mode":493},{"path":"/opt/bin/install-nano.sh","contents":{"compression":"gzip","source":"data:;base64,"},"mode":493},{"path":"/etc/systemd/system/hostname-fix.service","contents":{"compression":"gzip","source":"data:;base64,"},"mode":420},{"path":"/etc/sysctl.d/90-vm-tuning.conf","contents":{"compression":"","source":"data:,vm.swappiness%3D60%0A"},"mode":420},{"path":"/etc/tmpfiles.d/nfs-mounts.conf","contents":{"compression":"gzip","source":"data:;base64,H4sIAAAAAAAC/4TNQQrCQAyF4b2nmAtI3BSPI3ESaaCZSJLW60tpcSPtbN7mffBTAW0J7RWPGNGZyu0+DKWa8zbXy06USfD8BbVFOA7RWllwnvKDTtyOXSXMveVmuc3vFlWpY+eG+T0ZUk+toScG/7tvAAAA//9c/puAGgEAAA=="},"mode":420}]},"systemd":{"units":[{"contents":"[Unit]\nDescription=Configure zram swap device\nAfter=systemd-modules-load.service\nBefore=docker.service\n\n[Service]\nType=oneshot\nRemainAfterExit=true\nExecStart=/bin/bash -c '\\\n  modprobe zram \u0026\u0026 \\\n  echo 2G \u003e /sys/block/zram0/disksize \u0026\u0026 \\\n  mkswap /dev/zram0 \u0026\u0026 \\\n  swapon -p 100 /dev/zram0'\nExecStop=/bin/bash -c '\\\n  swapoff /dev/zram0 || true; \\\n  echo 1 \u003e /sys/block/zram0/reset || true'\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"zram-swap.service"},{"enabled":true,"name":"docker.service"},{"enabled":true,"name":"qemu-guest-agent.service"},{"contents":"[Unit]\nDescription=Create mount directories\nBefore=portainer-compose.service\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/mkdir -p /mnt/nfs_shared /mnt/media /mnt/media/movies /mnt/nfs_vaultwarden /mnt/ncdata /mnt/immich/upload /mnt/immich/database /opt/portainer /opt/bin /opt/vaultwarden /srv/docker/couchdb /srv/docker/dns /srv/docker/nextcloud /srv/docker/immich\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"create-mount-dirs.service"},{"contents":"[Unit]\nDescription=VirtioFS mount for shared storage\nAfter=local-fs.target\nConditionPathExists=/dev/tag-nfs_shared\n\n[Mount]\nWhat=nfs_shared\nWhere=/mnt/nfs_shared\nType=virtiofs\nOptions=defaults\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"mnt-nfs_shared.mount"},{"contents":"[Unit]\nDescription=NFS mount for shared storage (fallback)\nAfter=network-online.target\nWants=network-online.target\n\n[Mount]\nWhat=192.168.100.38:/mnt/nfs_shared\nWhere=/mnt/nfs_shared\nType=nfs4\nOptions=rw,fsc,noatime,vers=4.2,proto=tcp,rsize=1048576,wsize=1048576,soft,timeo=100,retrans=5,_netdev\n\n[Install]\nWantedBy=multi-user.target\n","enabled":false,"name":"mnt-nfs_shared-nfs.mount"},{"contents":"[Unit]\nDescription=Enable NFS mount if VirtioFS fails\nAfter=mnt-nfs_shared.mount\nBindsTo=mnt-nfs_shared.mount\n\n[Service]\nType=oneshot\nRemainAfterExit=true\nExecStart=/bin/bash -c 'if ! mountpoint -q /mnt/nfs_shared; then echo \"VirtioFS mount failed, enabling NFS fallback\"; systemctl disable mnt-nfs_shared.mount; systemctl enable mnt-nfs_shared-nfs.mount; systemctl start mnt-nfs_shared-nfs.mount; else echo \"VirtioFS mount successful\"; fi'\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"virtiofs-fallback.service"},{"contents":"[Unit]\nDescription=NFS mount for media storage from reginald\nRequires=network-online.target\nAfter=network-online.target\nBefore=docker.service media-stack-compose.service\n\n[Mount]\nWhat=192.168.200.4:/media\nWhere=/mnt/media\nType=nfs4\nOptions=rw,relatime,vers=4.2,rsize=1048576,wsize=1048576,namlen=255,hard,proto=tcp,timeo=600,retrans=2,sec=sys,_netdev\nTimeoutSec=300\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"mnt-media.mount"},{"contents":"[Unit]\nDescription=NFS mount for movies from rpool/shared on reginald\nRequires=network-online.target mnt-media.mount\nAfter=network-online.target mnt-media.mount\nBefore=docker.service media-stack-compose.service\n\n[Mount]\nWhat=192.168.200.4:/rpool/shared/media/movies\nWhere=/mnt/media/movies\nType=nfs4\nOptions=rw,relatime,vers=4.2,rsize=1048576,wsize=1048576,namlen=255,hard,proto=tcp,timeo=600,retrans=2,sec=sys,_netdev\nTimeoutSec=300\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"mnt-media-movies.mount"},{"contents":"[Unit]\nDescription=NFS mount for Nextcloud data from reginald\nRequires=network-online.target\nAfter=network-online.target\nBefore=docker.service nextcloud-stack.service\n\n[Mount]\nWhat=192.168.200.4:/rpool/shared/nextcloud\nWhere=/mnt/ncdata\nType=nfs4\nOptions=rw,relatime,vers=4.2,rsize=1048576,wsize=1048576,namlen=255,hard,proto=tcp,timeo=600,retrans=2,sec=sys,_netdev\nTimeoutSec=300\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"mnt-ncdata.mount"},{"contents":"[Unit]\nDescription=NFS mount for Immich library from reginald\nRequires=network-online.target\nAfter=network-online.target\nBefore=docker.service immich-stack.service\n\n[Mount]\nWhat=192.168.200.4:/rpool/shared/immich/library\nWhere=/mnt/immich/upload\nType=nfs4\nOptions=rw,relatime,vers=4.2,rsize=1048576,wsize=1048576,namlen=255,hard,proto=tcp,timeo=600,retrans=2,sec=sys,_netdev\nTimeoutSec=300\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"mnt-immich-upload.mount"},{"contents":"[Unit]\nDescription=NFS mount for Immich database from reginald\nRequires=network-online.target\nAfter=network-online.target\nBefore=docker.service immich-stack.service\n\n[Mount]\nWhat=192.168.200.4:/rpool/shared/immich/database\nWhere=/mnt/immich/database\nType=nfs4\nOptions=rw,relatime,vers=4.2,rsize=1048576,wsize=1048576,namlen=255,hard,proto=tcp,timeo=600,retrans=2,sec=sys,_netdev\nTimeoutSec=300\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"mnt-immich-database.mount"},{"contents":"[Unit]\nDescription=NFS mount for Vaultwarden\nAfter=network-online.target\nWants=network-online.target\n\n[Mount]\nWhat=192.168.200.4:/rpool/shared/vaultwarden\nWhere=/mnt/nfs_vaultwarden\nType=nfs4\nOptions=nofail,_netdev,soft,timeo=10,retrans=2,rw,noatime\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"mnt-nfs_vaultwarden.mount"},{"contents":"[Unit]\nDescription=Install nano via Docker wrapper\nAfter=network-online.target docker.service\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/opt/bin/install-nano.sh\nTimeoutStartSec=300\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"install-nano.service"},{"enabled":true,"name":"hostname-fix.service"},{"contents":"[Unit]\nDescription=Deploy Portainer via Docker Compose\nRequires=docker.service create-mount-dirs.service\nAfter=docker.service create-mount-dirs.service mnt-nfs_shared.mount mnt-media.mount\nWants=network-online.target install-nano.service\nAfter=network-online.target\n\n[Service]\nType=oneshot\nWorkingDirectory=/opt/portainer\nExecStart=/opt/bin/docker-compose up -d\nExecStop=/opt/bin/docker-compose down\nTimeoutStartSec=300\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"portainer-compose.service"},{"contents":"[Unit]\nDescription=Deploy Media Stack via Docker Compose\nRequires=docker.service mnt-media.mount\nAfter=docker.service mnt-media.mount\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nWorkingDirectory=/srv/docker/media-stack\nExecStartPre=/bin/sleep 10\nExecStart=/opt/bin/docker-compose up -d\nExecStop=/opt/bin/docker-compose down\nTimeoutStartSec=600\nRestart=on-failure\nRestartSec=30\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"media-stack-compose.service"},{"contents":"[Unit]\nDescription=Traefik Reverse Proxy Stack\nRequires=docker.service\nAfter=docker.service network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nWorkingDirectory=/srv/docker/traefik\nExecStartPre=-/usr/bin/docker network create -d macvlan --subnet=192.168.7.0/24 --gateway=192.168.7.1 --ip-range=192.168.7.119/32 -o parent=eth1 dmz_macvlan\nExecStartPre=-/usr/bin/docker network create traefik_internal\nExecStart=/opt/bin/docker-compose up -d\nExecStop=/opt/bin/docker-compose down\nTimeoutStartSec=300\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"traefik-stack.service"},{"contents":"[Unit]\nDescription=Deploy Caddy Reverse Proxy via Docker Compose\nRequires=docker.service\nAfter=docker.service\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nWorkingDirectory=/srv/docker/caddy\nExecStartPre=/bin/sleep 10\nExecStart=/opt/bin/docker-compose up -d\nExecStop=/opt/bin/docker-compose down\nTimeoutStartSec=300\nRestart=on-failure\nRestartSec=30\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"caddy-compose.service"},{"contents":"[Unit]\nDescription=CouchDB Stack (Obsidian LiveSync)\nRequires=docker.service\nAfter=docker.service\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=true\nWorkingDirectory=/srv/docker/couchdb\nExecStartPre=/bin/sleep 5\nExecStart=/opt/bin/docker-compose up -d --remove-orphans\nExecStop=/opt/bin/docker-compose down\nTimeoutStartSec=120\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"couchdb-stack.service"},{"contents":"[Unit]\nDescription=Technitium DNS Server (Secondary Node)\nRequires=docker.service\nAfter=docker.service\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=true\nWorkingDirectory=/srv/docker/dns\nExecStartPre=/bin/sleep 5\nExecStart=/opt/bin/docker-compose up -d --remove-orphans\nExecStop=/opt/bin/docker-compose down\nTimeoutStartSec=120\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"dns-compose.service"},{"contents":"[Unit]\nDescription=Set hostname to docker\nBefore=systemd-hostnamed.service\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/hostnamectl set-hostname docker\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"set-hostname.service"},{"contents":"[Unit]\nDescription=Sync gluetun forwarded port to qBittorrent\nAfter=docker.service\nRequires=docker.service\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/opt/bin/qbt-port-sync.sh\nStandardOutput=journal\nStandardError=journal\nRestart=on-failure\nRestartSec=30\n\n[Install]\nWantedBy=multi-user.target\n","enabled":false,"name":"qbt-port-sync.service"},{"contents":"[Unit]\nDescription=Run qBittorrent port sync every 5 minutes\n\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec=5min\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n","enabled":true,"name":"qbt-port-sync.timer"},{"contents":"[Unit]\nDescription=Cleanup old media trash files\nAfter=mnt-media.mount\nRequires=mnt-media.mount\n\n[Service]\nType=oneshot\nEnvironment=TRASH_DIR=/mnt/media/.trash\nEnvironment=TRASH_RETENTION_DAYS=7\nExecStart=/bin/bash -c 'find ${TRASH_DIR} -type f -mtime +${TRASH_RETENTION_DAYS} -delete 2\u003e/dev/null || true; find ${TRASH_DIR} -type d -empty -delete 2\u003e/dev/null || true'\n","enabled":false,"name":"media-trash-cleanup.service"},{"contents":"[Unit]\nDescription=Run media trash cleanup daily\n\n[Timer]\nOnCalendar=daily\nRandomizedDelaySec=3600\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n\nWantedBy=multi-user.target\n","enabled":true,"name":"media-trash-cleanup.timer"},{"contents":"[Unit]\nDescription=Vaultwarden backup to NFS\nRequires=docker.service mnt-nfs_vaultwarden.mount\nAfter=docker.service mnt-nfs_vaultwarden.mount\n\n[Service]\nType=oneshot\nExecStart=/opt/vaultwarden/backup.sh\n","enabled":false,"name":"vaultwarden-backup.service"},{"contents":"[Unit]\nDescription=Daily Vaultwarden backup\n\n[Timer]\nOnCalendar=*-*-* 03:00:00\nPersistent=true\nRandomizedDelaySec=300\n\n[Install]\nWantedBy=timers.target\n","enabled":true,"name":"vaultwarden-backup.timer"},{"contents":"[Unit]\nDescription=Nextcloud Docker Compose Stack\nRequires=docker.service mnt-ncdata.mount\nAfter=docker.service mnt-ncdata.mount\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nWorkingDirectory=/srv/docker/nextcloud\nExecStart=/opt/bin/docker-compose up -d --remove-orphans\nExecStop=/opt/bin/docker-compose down\nTimeoutStartSec=180\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"nextcloud-stack.service"},{"contents":"[Unit]\nDescription=Immich Docker Compose Stack\nRequires=docker.service mnt-immich-upload.mount mnt-immich-database.mount\nAfter=docker.service mnt-immich-upload.mount mnt-immich-database.mount\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nWorkingDirectory=/srv/docker/immich\nExecStart=/opt/bin/docker-compose up -d --remove-orphans\nExecStop=/opt/bin/docker-compose down\nTimeoutStartSec=180\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"immich-stack.service"},{"contents":"[Unit]\nDescription=Nextcloud Restic backup to MinIO S3\nRequires=docker.service mnt-ncdata.mount\nAfter=docker.service mnt-ncdata.mount\n\n[Service]\nType=oneshot\nExecStart=/opt/bin/backup-nextcloud.sh\nEnvironment=HOME=/home/core\nTimeoutStartSec=6h\n","enabled":false,"name":"nextcloud-backup.service"},{"contents":"[Unit]\nDescription=Daily Nextcloud Restic backup\n\n[Timer]\nOnCalendar=*-*-* 00:00:00\nPersistent=true\nRandomizedDelaySec=120\n\n[Install]\nWantedBy=timers.target\n","enabled":true,"name":"nextcloud-backup.timer"},{"contents":"[Unit]\nDescription=Immich Restic backup to MinIO S3\nRequires=docker.service mnt-immich-upload.mount mnt-immich-database.mount\nAfter=docker.service mnt-immich-upload.mount mnt-immich-database.mount\n\n[Service]\nType=oneshot\nExecStart=/opt/bin/backup-immich.sh\nEnvironment=HOME=/home/core\nTimeoutStartSec=6h\n","enabled":false,"name":"immich-backup.service"},{"contents":"[Unit]\nDescription=Daily Immich Restic backup\n\n[Timer]\nOnCalendar=*-*-* 00:00:00\nPersistent=true\nRandomizedDelaySec=120\n\n[Install]\nWantedBy=timers.target\n","enabled":true,"name":"immich-backup.timer"}]}}
