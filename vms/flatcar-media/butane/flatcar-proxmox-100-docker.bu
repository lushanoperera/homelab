variant: flatcar
version: 1.1.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-rsa  lushano@MacBook-Pro-di-Lushano.local

storage:
  files:
    # Static network configuration for VM (Infra VLAN)
    - path: /etc/systemd/network/10-static.network
      mode: 0644
      contents:
        inline: |
          [Match]
          Name=eth0

          [Network]
          Address=192.168.100.100/24
          Gateway=192.168.100.1
          DNS=192.168.100.254
          DNS=192.168.100.100
          DNS=192.168.100.120

    # DMZ network configuration (Traefik macvlan)
    - path: /etc/systemd/network/20-eth1-dmz.network
      mode: 0644
      contents:
        inline: |
          [Match]
          Name=eth1

          [Network]
          Address=192.168.7.119/24

    # Storage LAN network configuration (NFS traffic)
    - path: /etc/systemd/network/30-eth2-storage.network
      mode: 0644
      contents:
        inline: |
          [Match]
          Name=eth2

          [Network]
          Address=192.168.200.100/24

    # NFS client configuration
    - path: /etc/modules-load.d/nfs.conf
      mode: 0644
      contents:
        inline: |
          nfs
          nfsd
          rpcsec_gss_krb5

    # Docker Compose configuration for Portainer
    - path: /opt/portainer/docker-compose.yml
      mode: 0644
      contents:
        inline: |
          version: '3.8'
          services:
            portainer:
              image: portainer/portainer-ce:latest
              container_name: portainer
              mem_limit: 128m
              restart: unless-stopped
              ports:
                - "8000:8000"
                - "9443:9443"
              volumes:
                - portainer_data:/data
                - /var/run/docker.sock:/var/run/docker.sock
                - /mnt/nfs_shared:/mnt/nfs_shared
                - /mnt/media:/mnt/media
              security_opt:
                - no-new-privileges:true
          volumes:
            portainer_data:
              driver: local

    # Install Docker Compose v2 plugin
    - path: /usr/lib/docker/cli-plugins/docker-compose
      mode: 0755
      contents:
        source: https://github.com/docker/compose/releases/download/v2.40.3/docker-compose-linux-x86_64

    # Nano Docker wrapper installation script
    - path: /opt/bin/install-nano.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          # Install nano via Docker Alpine container (more reliable than toolbox)
          set -euo pipefail

          # Create nano wrapper in home directory (writable filesystem)
          cat > /home/core/nano << 'EOF'
          #!/bin/bash
          docker run --rm -it -v "$PWD":/workspace -w /workspace alpine:latest sh -c 'apk add --no-cache nano >/dev/null 2>&1 && nano "$@"' -- "$@"
          EOF

          chmod +x /home/core/nano
          chown core:core /home/core/nano

          echo "nano wrapper installed successfully at /home/core/nano"

    # Hostname fix service (fallback for timeout issues)
    - path: /etc/systemd/system/hostname-fix.service
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Fix hostname if set-hostname service fails
          After=set-hostname.service
          BindsTo=set-hostname.service

          [Service]
          Type=oneshot
          ExecStart=/bin/bash -c 'sleep 30; if [[ "$(hostname)" == "localhost" ]]; then hostnamectl set-hostname docker; fi'
          RemainAfterExit=true

          [Install]
          WantedBy=multi-user.target

    # i915 SR-IOV: Blacklist stock i915 to prevent udev auto-loading before sysext
    - path: /etc/modprobe.d/i915-blacklist.conf
      mode: 0644
      contents:
        inline: |
          # Prevent udev auto-loading stock i915 before sysext is ready
          # gpu-setup.service explicitly loads i915 after sysext activation
          blacklist i915

    # i915 SR-IOV: Module options for patched driver
    - path: /etc/modprobe.d/i915-sriov.conf
      mode: 0644
      contents:
        inline: |
          options i915 enable_guc=3

    # i915 SR-IOV: DRI device permissions for Docker GPU access
    - path: /etc/udev/rules.d/70-dri-permissions.rules
      mode: 0644
      contents:
        inline: |
          SUBSYSTEM=="drm", KERNEL=="renderD*", MODE="0660", GROUP="render"
          SUBSYSTEM=="drm", KERNEL=="card*", MODE="0660", GROUP="video"

    # i915 SR-IOV: GPU verification script
    - path: /opt/bin/verify-gpu.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -uo pipefail
          FAIL=0
          echo "=== Intel iGPU SR-IOV Verification ==="
          echo ""
          # PCI device
          if lspci | grep -qi vga; then
            echo "[PASS] VGA device found"
            lspci | grep -i vga
          else
            echo "[FAIL] No VGA device found"
            FAIL=1
          fi
          # DRI directory
          if [ -d /dev/dri ]; then
            echo "[PASS] /dev/dri exists"
          else
            echo "[FAIL] /dev/dri missing"
            FAIL=1
          fi
          # renderD device
          RENDER=$(ls /dev/dri/renderD* 2>/dev/null | head -1)
          if [ -n "$RENDER" ]; then
            echo "[PASS] Render device: $RENDER"
            ls -la "$RENDER"
          else
            echo "[FAIL] No renderD device found"
            FAIL=1
          fi
          # card device
          if ls /dev/dri/card* >/dev/null 2>&1; then
            echo "[PASS] Card device exists"
          else
            echo "[FAIL] No card device found"
            FAIL=1
          fi
          # i915 module
          if lsmod | grep -q "^i915 "; then
            echo "[PASS] i915 module loaded"
          else
            echo "[FAIL] i915 module not loaded"
            FAIL=1
          fi
          # Module path (sysext vs stock)
          MOD_PATH=$(modinfo -F filename i915 2>/dev/null)
          if echo "$MOD_PATH" | grep -q updates/; then
            echo "[PASS] Module from sysext: $MOD_PATH"
          else
            echo "[WARN] Module path: $MOD_PATH (may be stock)"
          fi
          echo ""
          if [ "$FAIL" -eq 0 ]; then
            echo "=== GPU Status: READY ==="
            exit 0
          else
            echo "=== GPU Status: FAILED ==="
            exit 1
          fi

    # i915 SR-IOV: Rebuild script for kernel updates
    - path: /opt/bin/i915-sriov-rebuild.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail
          KERN=$(uname -r)
          if [ -f "/usr/lib/modules/${KERN}/updates/i915/i915.ko" ]; then
            echo "i915-sriov sysext matches kernel ${KERN}, no rebuild needed"
            exit 0
          fi
          echo "Kernel mismatch - rebuilding i915-sriov sysext for ${KERN}..."
          cd /opt/i915-sriov-build
          ./build.sh "${KERN}"
          cp -f "i915-sriov-${KERN}"*.raw /etc/extensions/i915-sriov.raw
          systemd-sysext refresh
          depmod -a
          echo "Rebuild complete for kernel ${KERN}"

    # VM memory tuning: swappiness for zram
    - path: /etc/sysctl.d/90-vm-tuning.conf
      mode: 0644
      contents:
        inline: |
          vm.swappiness=60

    # Mount point creation via tmpfiles
    - path: /etc/tmpfiles.d/nfs-mounts.conf
      mode: 0644
      contents:
        inline: |
          d /mnt/nfs_shared 0755 core core -
          d /mnt/media 0755 core core -
          d /mnt/media/movies 0755 core core -
          d /mnt/nfs_vaultwarden 0755 core core -

systemd:
  units:
    # Zram swap — compressed RAM swap for OOM protection (29 containers, no disk swap)
    - name: zram-swap.service
      enabled: true
      contents: |
        [Unit]
        Description=Configure zram swap device
        After=systemd-modules-load.service
        Before=docker.service

        [Service]
        Type=oneshot
        RemainAfterExit=true
        ExecStart=/bin/bash -c '\
          modprobe zram && \
          echo 2G > /sys/block/zram0/disksize && \
          mkswap /dev/zram0 && \
          swapon -p 100 /dev/zram0'
        ExecStop=/bin/bash -c '\
          swapoff /dev/zram0 || true; \
          echo 1 > /sys/block/zram0/reset || true'

        [Install]
        WantedBy=multi-user.target

    # Enable Docker service
    - name: docker.service
      enabled: true

    # Enable QEMU Guest Agent
    - name: qemu-guest-agent.service
      enabled: true

    # Create mount point directories
    - name: create-mount-dirs.service
      enabled: true
      contents: |
        [Unit]
        Description=Create mount directories
        Before=mnt-nfs_shared.mount mnt-media.mount mnt-media-movies.mount mnt-nfs_vaultwarden.mount portainer-compose.service

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/mkdir -p /mnt/nfs_shared /mnt/media /mnt/media/movies /mnt/nfs_vaultwarden /opt/portainer /opt/bin /opt/vaultwarden /srv/docker/couchdb /srv/docker/dns
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    # VirtioFS mount for shared storage
    - name: mnt-nfs_shared.mount
      enabled: true
      contents: |
        [Unit]
        Description=VirtioFS mount for shared storage
        After=local-fs.target
        ConditionPathExists=/dev/tag-nfs_shared

        [Mount]
        What=nfs_shared
        Where=/mnt/nfs_shared
        Type=virtiofs
        Options=defaults

        [Install]
        WantedBy=multi-user.target

    # NFS fallback for shared storage (activated by virtiofs-fallback.service)
    - name: mnt-nfs_shared-nfs.mount
      enabled: false
      contents: |
        [Unit]
        Description=NFS mount for shared storage (fallback)
        After=network-online.target
        Wants=network-online.target

        [Mount]
        What=192.168.100.38:/mnt/nfs_shared
        Where=/mnt/nfs_shared
        Type=nfs4
        Options=rw,fsc,noatime,vers=4.2,proto=tcp,rsize=1048576,wsize=1048576,soft,timeo=100,retrans=5,_netdev

        [Install]
        WantedBy=multi-user.target

    # VirtioFS fallback — enables NFS mount if VirtioFS fails
    - name: virtiofs-fallback.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable NFS mount if VirtioFS fails
        After=mnt-nfs_shared.mount
        BindsTo=mnt-nfs_shared.mount

        [Service]
        Type=oneshot
        RemainAfterExit=true
        ExecStart=/bin/bash -c 'if ! mountpoint -q /mnt/nfs_shared; then echo "VirtioFS mount failed, enabling NFS fallback"; systemctl disable mnt-nfs_shared.mount; systemctl enable mnt-nfs_shared-nfs.mount; systemctl start mnt-nfs_shared-nfs.mount; else echo "VirtioFS mount successful"; fi'

        [Install]
        WantedBy=multi-user.target

    # NFS mount for media storage from reginald (Storage LAN)
    - name: mnt-media.mount
      enabled: true
      contents: |
        [Unit]
        Description=NFS mount for media storage from reginald
        Requires=network-online.target
        After=network-online.target
        Before=docker.service media-stack-compose.service

        [Mount]
        What=192.168.200.4:/media
        Where=/mnt/media
        Type=nfs4
        Options=rw,relatime,vers=4.2,rsize=1048576,wsize=1048576,namlen=255,hard,proto=tcp,timeo=600,retrans=2,sec=sys,_netdev
        TimeoutSec=300

        [Install]
        WantedBy=multi-user.target

    # NFS mount for movies from rpool/shared on reginald
    - name: mnt-media-movies.mount
      enabled: true
      contents: |
        [Unit]
        Description=NFS mount for movies from rpool/shared on reginald
        Requires=network-online.target mnt-media.mount
        After=network-online.target mnt-media.mount
        Before=docker.service media-stack-compose.service

        [Mount]
        What=192.168.200.4:/rpool/shared/media/movies
        Where=/mnt/media/movies
        Type=nfs4
        Options=rw,relatime,vers=4.2,rsize=1048576,wsize=1048576,namlen=255,hard,proto=tcp,timeo=600,retrans=2,sec=sys,_netdev
        TimeoutSec=300

        [Install]
        WantedBy=multi-user.target

    # NFS mount for Vaultwarden data from reginald
    - name: mnt-nfs_vaultwarden.mount
      enabled: true
      contents: |
        [Unit]
        Description=NFS mount for Vaultwarden
        After=network-online.target
        Wants=network-online.target

        [Mount]
        What=192.168.200.4:/rpool/shared/vaultwarden
        Where=/mnt/nfs_vaultwarden
        Type=nfs4
        Options=nofail,_netdev,soft,timeo=10,retrans=2,rw,noatime

        [Install]
        WantedBy=multi-user.target

    # Install nano via Docker wrapper
    - name: install-nano.service
      enabled: true
      contents: |
        [Unit]
        Description=Install nano via Docker wrapper
        After=network-online.target docker.service
        Wants=network-online.target

        [Service]
        Type=oneshot
        ExecStart=/opt/bin/install-nano.sh
        TimeoutStartSec=300
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    # Hostname fix service (fallback for boot timeout issues)
    - name: hostname-fix.service
      enabled: true

    # Portainer deployment service
    - name: portainer-compose.service
      enabled: true
      contents: |
        [Unit]
        Description=Deploy Portainer via Docker Compose
        Requires=docker.service create-mount-dirs.service
        After=docker.service create-mount-dirs.service mnt-nfs_shared.mount mnt-media.mount
        Wants=network-online.target install-nano.service
        After=network-online.target

        [Service]
        Type=oneshot
        WorkingDirectory=/opt/portainer
        ExecStart=/opt/bin/docker-compose up -d
        ExecStop=/opt/bin/docker-compose down
        TimeoutStartSec=300
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    # Media stack deployment service
    - name: media-stack-compose.service
      enabled: true
      contents: |
        [Unit]
        Description=Deploy Media Stack via Docker Compose
        Requires=docker.service mnt-media.mount
        After=docker.service mnt-media.mount
        Wants=network-online.target
        After=network-online.target

        [Service]
        Type=oneshot
        WorkingDirectory=/srv/docker/media-stack
        ExecStartPre=/bin/sleep 10
        ExecStart=/opt/bin/docker-compose up -d
        ExecStop=/opt/bin/docker-compose down
        TimeoutStartSec=600
        Restart=on-failure
        RestartSec=30
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    # Traefik reverse proxy stack (public, DMZ macvlan)
    - name: traefik-stack.service
      enabled: true
      contents: |
        [Unit]
        Description=Traefik Reverse Proxy Stack
        Requires=docker.service
        After=docker.service network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        WorkingDirectory=/srv/docker/traefik
        ExecStartPre=-/usr/bin/docker network create -d macvlan --subnet=192.168.7.0/24 --gateway=192.168.7.1 --ip-range=192.168.7.119/32 -o parent=eth1 dmz_macvlan
        ExecStartPre=-/usr/bin/docker network create traefik_internal
        ExecStart=/opt/bin/docker-compose up -d
        ExecStop=/opt/bin/docker-compose down
        TimeoutStartSec=300
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    # Caddy reverse proxy service (internal *.home.disconnesso.com)
    - name: caddy-compose.service
      enabled: true
      contents: |
        [Unit]
        Description=Deploy Caddy Reverse Proxy via Docker Compose
        Requires=docker.service
        After=docker.service
        Wants=network-online.target
        After=network-online.target

        [Service]
        Type=oneshot
        WorkingDirectory=/srv/docker/caddy
        ExecStartPre=/bin/sleep 10
        ExecStart=/opt/bin/docker-compose up -d
        ExecStop=/opt/bin/docker-compose down
        TimeoutStartSec=300
        Restart=on-failure
        RestartSec=30
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    # CouchDB stack (Obsidian LiveSync)
    - name: couchdb-stack.service
      enabled: true
      contents: |
        [Unit]
        Description=CouchDB Stack (Obsidian LiveSync)
        Requires=docker.service
        After=docker.service
        Wants=network-online.target
        After=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=true
        WorkingDirectory=/srv/docker/couchdb
        ExecStartPre=/bin/sleep 5
        ExecStart=/opt/bin/docker-compose up -d --remove-orphans
        ExecStop=/opt/bin/docker-compose down
        TimeoutStartSec=120

        [Install]
        WantedBy=multi-user.target

    # Technitium DNS server (secondary node)
    - name: dns-compose.service
      enabled: true
      contents: |
        [Unit]
        Description=Technitium DNS Server (Secondary Node)
        Requires=docker.service
        After=docker.service
        Wants=network-online.target
        After=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=true
        WorkingDirectory=/srv/docker/dns
        ExecStartPre=/bin/sleep 5
        ExecStart=/opt/bin/docker-compose up -d --remove-orphans
        ExecStop=/opt/bin/docker-compose down
        TimeoutStartSec=120

        [Install]
        WantedBy=multi-user.target

    # Set hostname
    - name: set-hostname.service
      enabled: true
      contents: |
        [Unit]
        Description=Set hostname to docker
        Before=systemd-hostnamed.service

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/hostnamectl set-hostname docker
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    # qBittorrent port sync with gluetun
    - name: qbt-port-sync.service
      enabled: false
      contents: |
        [Unit]
        Description=Sync gluetun forwarded port to qBittorrent
        After=docker.service
        Requires=docker.service
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        ExecStart=/opt/bin/qbt-port-sync.sh
        StandardOutput=journal
        StandardError=journal
        Restart=on-failure
        RestartSec=30

        [Install]
        WantedBy=multi-user.target

    - name: qbt-port-sync.timer
      enabled: true
      contents: |
        [Unit]
        Description=Run qBittorrent port sync every 5 minutes

        [Timer]
        OnBootSec=2min
        OnUnitActiveSec=5min
        Persistent=true

        [Install]
        WantedBy=timers.target

    # Media trash cleanup
    - name: media-trash-cleanup.service
      enabled: false
      contents: |
        [Unit]
        Description=Cleanup old media trash files
        After=mnt-media.mount
        Requires=mnt-media.mount

        [Service]
        Type=oneshot
        Environment=TRASH_DIR=/mnt/media/.trash
        Environment=TRASH_RETENTION_DAYS=7
        ExecStart=/bin/bash -c 'find ${TRASH_DIR} -type f -mtime +${TRASH_RETENTION_DAYS} -delete 2>/dev/null || true; find ${TRASH_DIR} -type d -empty -delete 2>/dev/null || true'

    - name: media-trash-cleanup.timer
      enabled: true
      contents: |
        [Unit]
        Description=Run media trash cleanup daily

        [Timer]
        OnCalendar=daily
        RandomizedDelaySec=3600
        Persistent=true

        [Install]
        WantedBy=timers.target

    # i915 SR-IOV: Load patched i915 and setup GPU after sysext activation
    - name: gpu-setup.service
      enabled: true
      contents: |
        [Unit]
        Description=Load patched i915 and setup GPU
        After=systemd-sysext.service i915-sriov-rebuild.service
        Wants=systemd-sysext.service
        ConditionPathExists=/etc/extensions/i915-sriov.raw

        [Service]
        Type=oneshot
        # Load i915 dependencies (depmod can't update indexes on read-only /lib/modules)
        ExecStartPre=/usr/sbin/modprobe drm
        ExecStartPre=/usr/sbin/modprobe drm_kms_helper
        ExecStartPre=/usr/sbin/modprobe drm_display_helper
        ExecStartPre=/usr/sbin/modprobe drm_buddy
        ExecStartPre=/usr/sbin/modprobe ttm
        ExecStartPre=/usr/sbin/modprobe drm_ttm_helper
        ExecStartPre=/usr/sbin/modprobe video
        ExecStartPre=/usr/sbin/modprobe intel-gtt
        ExecStartPre=/usr/sbin/modprobe i2c-algo-bit
        ExecStartPre=/usr/sbin/modprobe hwmon
        # Load sysext i915 via insmod (modprobe would load stock module from stale index)
        ExecStartPre=/bin/sh -c 'test -d /sys/module/i915 || /usr/sbin/insmod /usr/lib/modules/$(uname -r)/updates/i915/i915.ko enable_guc=3'
        ExecStartPre=/usr/bin/udevadm control --reload-rules
        ExecStartPre=/usr/bin/udevadm trigger --subsystem-match=drm
        ExecStart=/opt/bin/verify-gpu.sh
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    # i915 SR-IOV: Rebuild sysext if kernel changed (Flatcar auto-update)
    - name: i915-sriov-rebuild.service
      enabled: true
      contents: |
        [Unit]
        Description=Rebuild i915-sriov sysext if kernel changed
        After=docker.service systemd-sysext.service
        Before=gpu-setup.service
        ConditionPathExists=/etc/extensions/i915-sriov.raw

        [Service]
        Type=oneshot
        ExecStart=/opt/bin/i915-sriov-rebuild.sh
        RemainAfterExit=true
        TimeoutStartSec=600

        [Install]
        WantedBy=multi-user.target

    # Vaultwarden backup to NFS
    - name: vaultwarden-backup.service
      enabled: false
      contents: |
        [Unit]
        Description=Vaultwarden backup to NFS
        Requires=docker.service mnt-nfs_vaultwarden.mount
        After=docker.service mnt-nfs_vaultwarden.mount

        [Service]
        Type=oneshot
        ExecStart=/opt/vaultwarden/backup.sh

    - name: vaultwarden-backup.timer
      enabled: true
      contents: |
        [Unit]
        Description=Daily Vaultwarden backup

        [Timer]
        OnCalendar=*-*-* 03:00:00
        Persistent=true
        RandomizedDelaySec=300

        [Install]
        WantedBy=timers.target
